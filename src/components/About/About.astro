---
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
const { about, languages } = data;
const words = about.statement.split(' ');
---

<section class="about section" id="about" aria-labelledby="about-title">
	<div class="container">
		<h2 class="about__eyebrow" id="about-title" data-reveal>{t.about.eyebrow}</h2>
		<p class="about__statement" data-progress="view" style={`--n: ${words.length}`}>
			{words.map((word, i) => <span style={`--i: ${i}`}>{word} </span>)}
		</p>

		<div class="about__grid">
			<div class="about__text" data-reveal-group>
				{about.paragraphs.map((paragraph) => <p data-reveal>{paragraph}</p>)}
			</div>

			<dl class="about__facts tile" data-reveal>
				{
					about.facts.map((fact) => (
						<div class="about__fact">
							<dt>{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))
				}
			</dl>

			<div class="about__languages tile" data-reveal>
				<h3>{t.about.languages}</h3>
				<ul>
					{
						languages.map((language) => (
							<li style={`--level: ${language.proficiency}`}>
								<span class="about__language">{language.name}</span>
								<span class="about__level">{language.level}</span>
								<span class="about__meter" aria-hidden="true" />
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.about__eyebrow {
		font-size: var(--fs-subtitle);
		letter-spacing: -0.015em;
		color: var(--text-secondary);
		margin-bottom: 1.25rem;
	}

	.about__statement {
		max-width: 24ch;
		font-size: var(--fs-headline);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.028em;
	}

	/*
	 * Words go from gray to full color while the statement crosses the
	 * viewport. The gray keeps large-text contrast, so it stays readable.
	 */
	:global(.js) .about__statement span {
		--lit: clamp(0, calc((var(--progress, 0) * 2.2 - 0.45) * var(--n) - var(--i)), 1);

		color: color-mix(in srgb, var(--text) calc(var(--lit) * 100%), var(--text-tertiary));
		transition: color 150ms linear;
	}

	.about__grid {
		display: grid;
		gap: 1rem;
		margin-top: clamp(4rem, 3rem + 5vw, 7rem);
	}

	.about__text {
		display: grid;
		gap: 1.25rem;
		align-content: start;
		padding-block: 0.5rem 2rem;
		font-size: var(--fs-lead);
		color: var(--text-secondary);
	}

	.about__facts {
		display: grid;
		gap: 1.5rem;
		align-content: start;
	}

	.about__fact dt,
	.about__languages h3 {
		font-size: var(--fs-small);
		font-weight: 400;
		letter-spacing: -0.01em;
		color: var(--text-secondary);
	}

	.about__fact dd {
		margin-top: 0.2rem;
		font-size: var(--fs-subtitle);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.about__languages ul {
		display: grid;
		gap: 1.5rem;
		margin-top: 1.25rem;
	}

	.about__languages li {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.6rem;
		align-items: baseline;
	}

	.about__language {
		font-size: var(--fs-subtitle);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.about__level {
		font-size: var(--fs-small);
		color: var(--text-secondary);
	}

	.about__meter {
		grid-column: 1 / -1;
		height: 4px;
		border-radius: 2px;
		background: var(--line-soft);
		overflow: hidden;
	}

	.about__meter::after {
		content: '';
		display: block;
		height: 100%;
		border-radius: inherit;
		background: var(--text);
		transform-origin: left;
		transform: scaleX(var(--level));
		transition: transform 1.4s var(--ease-out) 300ms;
	}

	:global(.js) .about__languages:not(:global(.is-visible)) .about__meter::after {
		transform: scaleX(0);
	}

	@media (min-width: 64rem) {
		.about__grid {
			grid-template-columns: 1.3fr 1fr 1fr;
		}

		.about__text {
			padding-right: 2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.js) .about__statement span {
			color: var(--text);
		}
	}
</style>
