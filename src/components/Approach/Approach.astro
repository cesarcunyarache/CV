---
import SectionHeading from '../ui/SectionHeading.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
---

<section class="approach section" id="approach" aria-labelledby="approach-title">
	<div class="container">
		<SectionHeading title={t.headings.approach.title} subtitle={t.headings.approach.subtitle} id="approach-title" />

		<ol class="approach__grid" data-reveal-group>
			{
				data.principles.map((principle, i) => (
					<li class="approach__step tile" data-reveal>
						<span class="approach__number" aria-hidden="true">
							{i + 1}
						</span>
						<h3 class="approach__title">{principle.title}</h3>
						<p class="approach__description">{principle.description}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.approach__grid {
		display: grid;
		gap: 1rem;
	}

	.approach__step {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.approach__number {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		margin-bottom: auto;
		border-radius: 50%;
		background: var(--text);
		color: var(--bg);
		font-size: var(--fs-small);
		font-weight: 600;
	}

	.approach__title {
		margin-top: 1.5rem;
		font-size: var(--fs-title);
		letter-spacing: -0.025em;
	}

	.approach__description {
		max-width: 34ch;
		font-size: var(--fs-lead);
		color: var(--text-secondary);
	}

	@media (min-width: 48rem) {
		.approach__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.approach__step {
			min-height: 18rem;
		}

		.approach__title {
			margin-top: 3rem;
		}
	}
</style>
