---
import Button from '../ui/Button.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
const { contact, contactSection, profile } = data;
const stripProtocol = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '');

const channels: { label: string; value: string; href: string; icon: IconName; external: boolean }[] = [
	{ label: t.contact.emailLabel, value: contact.email, href: `mailto:${contact.email}`, icon: 'mail', external: false },
	{ label: 'LinkedIn', value: stripProtocol(contact.linkedin), href: contact.linkedin, icon: 'linkedin', external: true },
	{ label: 'GitHub', value: stripProtocol(contact.github), href: contact.github, icon: 'github', external: true },
];
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
	<div class="container">
		<div class="contact__intro">
			<p class="contact__eyebrow" data-reveal>{t.contact.eyebrow}</p>
			<h2 class="contact__title" id="contact-title" data-reveal>{contactSection.title}</h2>
			<p class="contact__description" data-reveal>{contactSection.description}</p>
			<div class="contact__actions" data-reveal>
				<Button href={`mailto:${contact.email}`} size="large">{t.contact.email}</Button>
				<button class="contact__copy link" type="button" data-copy={contact.email} data-copied-label={t.contact.copied}>
					<Icon name="copy" size={17} class="contact__copy-icon" />
					<Icon name="check" size={17} class="contact__check-icon" />
					<span data-copy-label aria-live="polite">{t.contact.copy}</span>
				</button>
			</div>
		</div>

		<ul class="contact__channels" data-reveal-group>
			{
				channels.map((channel) => (
					<li data-reveal>
						<a
							class="channel tile"
							href={channel.href}
							target={channel.external ? '_blank' : undefined}
							rel={channel.external ? 'noopener noreferrer' : undefined}
						>
							<Icon name={channel.icon} size={26} class="channel__icon" />
							<span class="channel__label">{channel.label}</span>
							<span class="channel__value">{channel.value}</span>
							{channel.external && <span class="sr-only">{t.a11y.opensInNewTab}</span>}
						</a>
					</li>
				))
			}
		</ul>

		<p class="contact__time">
			{t.contact.localTime} {profile.location.city}:
			<time class="contact__clock" data-clock data-time-zone={profile.location.timeZone}>--:--</time>
		</p>
	</div>
</section>

<style>
	.contact__intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.contact__eyebrow {
		font-size: var(--fs-subtitle);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--text-secondary);
	}

	.contact__title {
		max-width: 14ch;
		margin-top: 0.5rem;
		font-size: var(--fs-hero);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.035em;
	}

	.contact__description {
		max-width: 36rem;
		margin-top: 1.5rem;
		font-size: var(--fs-lead);
		color: var(--text-secondary);
	}

	.contact__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1rem 2rem;
		margin-top: 2.25rem;
	}

	.contact__copy {
		gap: 0.45rem;
		min-height: 2.75rem;
		font-size: var(--fs-lead);
	}

	.contact__copy[hidden] {
		display: none;
	}

	.contact__copy :global(.contact__check-icon),
	.contact__copy:global(.is-copied) :global(.contact__copy-icon) {
		display: none;
	}

	.contact__copy:global(.is-copied) :global(.contact__check-icon) {
		display: block;
		color: var(--success);
	}

	.contact__channels {
		display: grid;
		gap: 1rem;
		margin-top: clamp(4rem, 3rem + 4vw, 6rem);
	}

	.channel {
		display: grid;
		gap: 0.2rem;
		height: 100%;
		transition: transform var(--dur-component) var(--ease-out);
	}

	.channel :global(.channel__icon) {
		margin-bottom: 1.25rem;
		color: var(--text-secondary);
		transition: color var(--dur-micro) var(--ease-out);
	}

	.channel__label {
		font-size: var(--fs-small);
		color: var(--text-secondary);
	}

	.channel__value {
		font-size: var(--fs-lead);
		font-weight: 600;
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	@media (hover: hover) {
		.channel:hover {
			transform: scale(1.02);
		}

		.channel:hover :global(.channel__icon) {
			color: var(--accent);
		}
	}

	.contact__time {
		margin-top: 3rem;
		text-align: center;
		font-size: var(--fs-small);
		color: var(--text-secondary);
	}

	.contact__clock {
		color: var(--text);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	@media (min-width: 48rem) {
		.contact__channels {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
