---
import Icon from '../ui/Icon.astro';
import type { ResolvedPortfolio } from '../../data';

interface Props {
	title: string;
	items: ResolvedPortfolio['certifications'];
	newTabLabel: string;
}

const { title, items, newTabLabel } = Astro.props;
---

<div class="certs">
	<h3 class="certs__title" data-reveal>{title}</h3>
	<ul class="certs__list" data-reveal-group>
		{
			items.map((item) => {
				const details = [item.issuer, item.year].filter(Boolean).join(' · ');
				const body = (
					<>
						<span class="cert__name">{item.name}</span>
						{details && <span class="cert__details">{details}</span>}
					</>
				);
				return (
					<li class="cert" data-reveal>
						{item.url ? (
							<a class="cert__link" href={item.url} target="_blank" rel="noopener noreferrer">
								{body}
								<span class="sr-only">{newTabLabel}</span>
								<Icon name="arrow-up-right" size={16} class="cert__arrow" />
							</a>
						) : (
							body
						)}
					</li>
				);
			})
		}
	</ul>
</div>

<style>
	.certs__title {
		margin-bottom: 0.75rem;
		font-size: var(--fs-small);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text-secondary);
	}

	.cert,
	.cert__link {
		display: grid;
		gap: 0.2rem;
	}

	.cert {
		padding-block: 1.1rem;
		border-bottom: 1px solid var(--line);
	}

	.cert:first-child {
		border-top: 1px solid var(--line);
	}

	.cert__link {
		position: relative;
		padding-right: 2rem;
	}

	.cert__name {
		font-size: var(--fs-lead);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.3;
	}

	.cert__details {
		font-size: var(--fs-small);
		color: var(--text-secondary);
	}

	.cert__link :global(.cert__arrow) {
		position: absolute;
		top: 0.35rem;
		right: 0;
		color: var(--accent);
	}
</style>
