---
import Certifications from './Certifications.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { formatRange, type Content } from '../../data';
import type { Locale } from '../../i18n/config';

interface Props {
	content: Content;
	locale: Locale;
}

const { content, locale } = Astro.props;
const { data, t } = content;

/** Every year between start and end, for the timeline ticks. */
const yearsOf = (start: string, end?: string) => {
	const from = Number(start.slice(0, 4));
	const to = Number((end ?? String(new Date().getFullYear())).slice(0, 4));
	return Array.from({ length: Math.max(1, to - from + 1) }, (_, i) => from + i);
};
---

<section class="education section section--alt" id="education" aria-labelledby="education-title">
	<div class="container">
		<SectionHeading title={t.headings.education.title} subtitle={t.headings.education.subtitle} id="education-title" />

		<div class="education__grid">
			<div class="education__degrees">
				{
					data.education.map((item) => (
						<article class="degree tile" data-reveal>
							<p class="degree__range">{formatRange(item.start, item.end, locale, t.experience.present)}</p>
							<h3 class="degree__title">{item.degree}</h3>
							<p class="degree__institution">
								{item.institution} <span class="muted">· {item.location}</span>
							</p>
							<ol class="degree__timeline" aria-hidden="true">
								{yearsOf(item.start, item.end).map((year, i) => (
									<li style={`--i: ${i}`}>{year}</li>
								))}
							</ol>
						</article>
					))
				}
			</div>

			<Certifications title={t.education.certifications} items={data.certifications} newTabLabel={t.a11y.opensInNewTab} />
		</div>
	</div>
</section>

<style>
	.education__grid {
		display: grid;
		gap: 3.5rem;
	}

	.degree {
		display: grid;
		gap: 0.5rem;
	}

	.degree__range {
		font-size: var(--fs-small);
		font-weight: 600;
		color: var(--text-secondary);
	}

	.degree__title {
		font-size: var(--fs-title);
		letter-spacing: -0.028em;
	}

	.degree__institution {
		font-size: var(--fs-lead);
	}

	/* Year ticks along a line that draws itself when revealed */
	.degree__timeline {
		position: relative;
		display: flex;
		justify-content: space-between;
		margin-top: 2.5rem;
		padding-top: 1rem;
		font-size: var(--fs-caption);
		color: var(--text-secondary);
		font-variant-numeric: tabular-nums;
	}

	.degree__timeline::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 2px;
		border-radius: 1px;
		background: linear-gradient(90deg, var(--line), var(--accent-fill));
		transform-origin: left;
		transition: transform 1.6s var(--ease-out) 300ms;
	}

	.degree__timeline li {
		position: relative;
		transition: opacity var(--dur-component) var(--ease-out);
		transition-delay: calc(400ms + var(--i) * 160ms);
	}

	.degree__timeline li::before {
		content: '';
		position: absolute;
		top: calc(-1rem - 3px);
		left: 50%;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--surface);
		box-shadow: inset 0 0 0 2px var(--line);
		translate: -50% 0;
	}

	.degree__timeline li:last-child::before {
		background: var(--accent-fill);
		box-shadow: none;
	}

	:global(.js) .degree:not(:global(.is-visible)) .degree__timeline::before {
		transform: scaleX(0);
	}

	:global(.js) .degree:not(:global(.is-visible)) .degree__timeline li {
		opacity: 0;
	}

	@media (min-width: 64rem) {
		.education__grid {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
			align-items: start;
		}
	}
</style>
