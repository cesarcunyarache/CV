---
import ExperienceItem from './ExperienceItem.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Content } from '../../data';
import type { Locale } from '../../i18n/config';

interface Props {
	content: Content;
	locale: Locale;
	index: number;
}

const { content, locale, index } = Astro.props;
const { data, t } = content;
---

<section class="experience section" id="experience" aria-labelledby="experience-title">
	<div class="container">
		<SectionHeading index={index} label={t.nav.experience} title={t.sectionTitles.experience} id="experience-title" />
		<div class="experience__list">
			{data.experience.map((item) => <ExperienceItem item={item} locale={locale} t={t} />)}
		</div>
	</div>
</section>

<style>
	.experience__list {
		display: grid;
		gap: var(--space-section);
	}
</style>
