---
import MetricComparison from './MetricComparison.astro';
import { formatRange, type ResolvedPortfolio, type UI } from '../../data';
import type { Locale } from '../../i18n/config';

interface Props {
	item: ResolvedPortfolio['experience'][number];
	locale: Locale;
	t: UI;
}

const { item, locale, t } = Astro.props;
const range = formatRange(item.start, item.end, locale, t.experience.present);
---

<article class="job">
	<div class="job__main">
		<header class="job__header" data-reveal>
			<p class="job__range">
				{!item.end && <span class="job__live" aria-hidden="true" />}
				{range}
			</p>
			<h3 class="job__company">{item.company}</h3>
			<p class="job__role">
				{item.role} <span class="muted">· {item.location}</span>
			</p>
			{item.summary && <p class="job__summary">{item.summary}</p>}
		</header>

		<ul class="job__highlights" data-reveal-group>
			{item.highlights.map((highlight) => <li data-reveal>{highlight}</li>)}
		</ul>
	</div>

	{
		item.caseStudy && (
			<div class="job__case">
				<div class="job__case-head" data-reveal>
					<p class="job__case-eyebrow">{t.experience.caseStudy}</p>
					<p class="job__case-title">{item.caseStudy.title}</p>
					<p class="muted">{item.caseStudy.context}</p>
				</div>
				<div class="job__metrics" data-reveal-group>
					{item.caseStudy.metrics.map((metric) => (
						<MetricComparison metric={metric} locale={locale} t={t} />
					))}
				</div>
			</div>
		)
	}
</article>

<style>
	.job {
		display: grid;
		gap: clamp(3rem, 2rem + 3vw, 5rem);
	}

	.job__main {
		display: grid;
		gap: 2.5rem;
	}

	.job__header {
		display: grid;
		gap: 0.5rem;
		align-content: start;
	}

	.job__range {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--fs-small);
		font-weight: 600;
		color: var(--text-secondary);
	}

	.job__live {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--success);
	}

	.job__company {
		font-size: var(--fs-title);
		letter-spacing: -0.028em;
	}

	.job__role {
		font-size: var(--fs-lead);
	}

	.job__summary {
		color: var(--text-secondary);
	}

	.job__highlights li {
		padding-block: 1.25rem;
		border-top: 1px solid var(--line);
		font-size: var(--fs-lead);
		line-height: 1.45;
	}

	.job__highlights li:last-child {
		border-bottom: 1px solid var(--line);
	}

	.job__case {
		display: grid;
		gap: 1.5rem;
	}

	.job__case-head {
		display: grid;
		gap: 0.35rem;
	}

	.job__case-eyebrow {
		font-size: var(--fs-small);
		font-weight: 600;
		color: var(--accent);
	}

	.job__case-title {
		font-size: var(--fs-title);
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.1;
	}

	.job__metrics {
		display: grid;
		gap: 1rem;
	}

	@media (min-width: 48rem) {
		.job__metrics {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.job__main {
			grid-template-columns: 5fr 7fr;
			column-gap: 4rem;
		}

		.job__header {
			position: sticky;
			top: calc(var(--header-height) + 2rem);
		}
	}
</style>
