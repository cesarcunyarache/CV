---
import type { Locale } from '../../i18n/config';
import type { ResolvedPortfolio, UI } from '../../data';

type Metric = NonNullable<ResolvedPortfolio['experience'][number]['caseStudy']>['metrics'][number];

interface Props {
	metric: Metric;
	locale: Locale;
	t: UI;
}

const { metric, locale, t } = Astro.props;
const ratio = metric.after / metric.before;
const blocks = metric.visual === 'blocks' ? Array.from({ length: metric.before }, (_, i) => i < metric.after) : [];
const reduction = new Intl.NumberFormat(locale, { style: 'percent', maximumFractionDigits: 1 }).format(1 - ratio);
---

<div class="metric tile" data-reveal data-spotlight style={`--ratio: ${ratio}`}>
	<h4 class="metric__label">{metric.label}</h4>

	<p class="metric__value">
		<span class="sr-only">{t.experience.before}: {metric.before} {metric.unit}. {t.experience.after}: {metric.after} {metric.unit}.</span>
		<span class="metric__before" aria-hidden="true">{metric.before}</span>
		<span class="metric__arrow" aria-hidden="true">→</span>
		<span class="metric__number" aria-hidden="true" data-count-from={metric.before}>{metric.after}</span>
		<span class="metric__unit" aria-hidden="true">{metric.unit}</span>
	</p>

	<p class="metric__delta">{reduction} {t.experience.reduction}</p>

	{
		blocks.length > 0 ? (
			<div class="metric__blocks" aria-hidden="true" style={`--count: ${blocks.length}`}>
				{blocks.map((kept, i) => (
					<span class:list={['metric__block', { 'is-kept': kept }]} style={`--b: ${i}`} />
				))}
			</div>
		) : (
			<div class="metric__bars" aria-hidden="true">
				<div class="metric__row">
					<span>{t.experience.before}</span>
					<span class="metric__bar" />
				</div>
				<div class="metric__row">
					<span>{t.experience.after}</span>
					<span class="metric__bar metric__bar--after" />
				</div>
			</div>
		)
	}
</div>

<style>
	.metric {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.metric__label {
		font-size: var(--fs-lead);
		letter-spacing: -0.02em;
	}

	.metric__value {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.4rem 0.75rem;
		margin-top: 1rem;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}

	.metric__before,
	.metric__arrow {
		font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--text-secondary);
	}

	.metric__before {
		text-decoration: line-through;
		text-decoration-thickness: 2px;
	}

	.metric__number {
		font-size: clamp(3.5rem, 2.5rem + 4vw, 6rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		background: linear-gradient(135deg, #3d8bff, var(--accent-fill));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.metric__unit {
		font-size: var(--fs-subtitle);
		font-weight: 600;
		color: var(--text-secondary);
	}

	.metric__delta {
		font-size: var(--fs-body);
		font-weight: 600;
		color: var(--accent);
	}

	.metric__bars {
		display: grid;
		gap: 0.6rem;
		margin-top: auto;
		padding-top: 1.5rem;
	}

	.metric__row {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		align-items: center;
		gap: 0.75rem;
		font-size: var(--fs-caption);
		color: var(--text-secondary);
	}

	.metric__bar {
		height: 6px;
		border-radius: 3px;
		background: var(--line);
		transform-origin: left;
	}

	/* The "after" bar shrinks from the "before" length to its real ratio */
	.metric__bar--after {
		background: var(--accent-fill);
		transform: scaleX(var(--ratio));
		transition: transform 1.6s var(--ease-out) 300ms;
	}

	:global(.js) .metric:not(:global(.is-visible)) .metric__bar--after {
		transform: scaleX(1);
	}

	/* One block per unit: the removed ones fade to dashed outlines, the kept ones light up */
	.metric__blocks {
		display: grid;
		grid-template-columns: repeat(var(--count), minmax(0, 1fr));
		gap: 0.4rem;
		margin-top: auto;
		padding-top: 1.5rem;
	}

	.metric__block {
		height: 2.25rem;
		border-radius: 0.6rem;
		background: var(--line);
		outline: 1.5px dashed transparent;
		outline-offset: -1.5px;
		transition:
			transform 800ms var(--ease-out),
			background-color 600ms var(--ease-out),
			outline-color 600ms var(--ease-out);
		transition-delay: calc(400ms + var(--b) * 80ms);
	}

	.metric__block:not(.is-kept) {
		background: transparent;
		outline-color: var(--line);
		transform: scale(0.88);
	}

	.metric__block.is-kept {
		background: var(--accent-fill);
		box-shadow: 0 10px 24px -10px rgb(10 108 230 / 0.6);
		transition-delay: 1s;
	}

	:global(.js) .metric:not(:global(.is-visible)) .metric__block {
		opacity: 1;
		transform: none;
		background: var(--line);
		box-shadow: none;
	}
</style>
