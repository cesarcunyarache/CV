---
import Icon from '../ui/Icon.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="footer__inner container">
		<p class="footer__name">
			© {year} {data.profile.name}
		</p>
		<p class="footer__meta label">{t.footer.builtWith}</p>
		<a class="footer__top link" href="#top">
			{t.a11y.backToTop}
			<Icon name="arrow-up-right" size={14} class="arrow" />
		</a>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--line);
	}

	.footer__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		padding-block: 2rem;
		font-size: var(--step-meta);
		color: var(--text-muted);
	}

	.footer__top {
		min-height: 2.75rem;
	}
</style>
