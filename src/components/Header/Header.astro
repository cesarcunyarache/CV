---
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { localePath, type Locale } from '../../i18n/config';
import type { Content } from '../../data';

interface Props {
	locale: Locale;
	content: Content;
}

const { locale, content } = Astro.props;
const { data, t } = content;
const home = localePath(locale);
const items = t.navItems.map((id) => ({ id, label: t.nav[id], href: `${home}#${id}` }));
---

<div class="nav-sentinel" data-header-sentinel aria-hidden="true"></div>
<header class="nav" data-header>
	<div class="nav__bar container">
		<a class="nav__brand" href={`${home}#top`}>{data.profile.shortName}</a>

		<nav class="nav__links" aria-label={t.a11y.mainNav}>
			<ul>
				{
					items.map((item) => (
						<li>
							<a class="nav__link" href={item.href} data-nav-link>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="nav__actions">
			<LanguageSwitcher current={locale} label={t.a11y.languageSwitcher} />
			<ThemeToggle label={t.a11y.themeToggle} />
			<button
				class="nav__toggle"
				type="button"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label={t.a11y.openMenu}
				data-menu-toggle
				data-label-open={t.a11y.openMenu}
				data-label-close={t.a11y.closeMenu}
			>
				<span class="nav__toggle-line" aria-hidden="true"></span>
				<span class="nav__toggle-line" aria-hidden="true"></span>
			</button>
		</div>
	</div>

	<div class="nav__menu" id="mobile-menu">
		<nav aria-label={t.a11y.mainNav}>
			<ul>
				{
					items.map((item, index) => (
						<li style={`--i: ${index}`}>
							<a class="nav__menu-link" href={item.href} data-nav-link>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.nav-sentinel {
		position: absolute;
		top: 0;
		width: 1px;
		height: 2rem;
	}

	.nav {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
	}

	.nav__bar {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: var(--header-height);
	}

	/* Translucent bar spanning the full width */
	.nav::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		z-index: 1;
		height: var(--header-height);
		background: var(--nav-bg);
		backdrop-filter: saturate(180%) blur(20px);
		-webkit-backdrop-filter: saturate(180%) blur(20px);
		box-shadow: 0 1px 0 transparent;
		transition: box-shadow var(--dur-component) var(--ease-out);
	}

	.nav:global(.is-scrolled)::before {
		box-shadow: 0 1px 0 var(--line-soft);
	}

	.nav__brand {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.nav__links {
		display: none;
	}

	.nav__links ul {
		display: flex;
		gap: 0.25rem;
	}

	.nav__link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding-inline: 0.85rem;
		font-size: var(--fs-caption);
		color: var(--text-secondary);
		transition: color var(--dur-micro) var(--ease-out);
	}

	.nav__link:hover,
	.nav__link[aria-current] {
		color: var(--text);
	}

	.nav__actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.nav__toggle {
		display: grid;
		place-content: center;
		gap: 7px;
		width: 2.75rem;
		height: 2.75rem;
	}

	.nav__toggle-line {
		display: block;
		width: 1.05rem;
		height: 1.5px;
		border-radius: 1px;
		background: currentColor;
		transition: transform var(--dur-component) var(--ease-out);
	}

	.nav:global(.is-menu-open) .nav__toggle-line:first-child {
		transform: translateY(4.25px) rotate(45deg);
	}

	.nav:global(.is-menu-open) .nav__toggle-line:last-child {
		transform: translateY(-4.25px) rotate(-45deg);
	}

	/* Mobile full-screen menu */
	.nav__menu {
		position: fixed;
		inset: 0;
		z-index: 1;
		padding: calc(var(--header-height) + 1.5rem) var(--gutter) 2rem;
		background: var(--bg);
		visibility: hidden;
		opacity: 0;
		transition:
			opacity var(--dur-component) var(--ease-out),
			visibility 0s linear var(--dur-component);
	}

	.nav:global(.is-menu-open) .nav__menu {
		visibility: visible;
		opacity: 1;
		transition: opacity var(--dur-component) var(--ease-out);
	}

	.nav__menu li {
		opacity: 0;
		transform: translateY(-0.5rem);
		transition:
			opacity var(--dur-component) var(--ease-out),
			transform var(--dur-component) var(--ease-out);
		transition-delay: calc(var(--i) * 40ms + 80ms);
	}

	.nav:global(.is-menu-open) .nav__menu li {
		opacity: 1;
		transform: none;
	}

	.nav__menu-link {
		display: block;
		padding-block: 0.6rem;
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.025em;
	}

	.nav__menu-link[aria-current] {
		color: var(--text-secondary);
	}

	@media (min-width: 48rem) {
		.nav__links {
			display: block;
		}

		.nav__toggle,
		.nav__menu {
			display: none;
		}
	}
</style>
