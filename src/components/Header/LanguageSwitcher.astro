---
import { localeMeta, localePath, locales, type Locale } from '../../i18n/config';

interface Props {
	current: Locale;
	label: string;
}

const { current, label } = Astro.props;
---

<nav class="lang" aria-label={label}>
	{
		locales.map((locale) => (
			<a
				class="lang__link"
				href={localePath(locale)}
				hreflang={localeMeta[locale].htmlLang}
				lang={localeMeta[locale].htmlLang}
				aria-current={locale === current ? 'page' : undefined}
				title={localeMeta[locale].name}
			>
				<span class="sr-only">{localeMeta[locale].name}</span>
				<span aria-hidden="true">{localeMeta[locale].label}</span>
			</a>
		))
	}
</nav>

<style>
	.lang {
		display: flex;
		align-items: center;
		padding: 0.2rem;
		border-radius: 999px;
		background: var(--line-soft);
		font-size: var(--fs-caption);
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	.lang__link {
		display: grid;
		place-items: center;
		min-width: 2.25rem;
		min-height: 1.85rem;
		border-radius: 999px;
		/* Slightly darker than --text-secondary: it sits on the tinted track */
		color: light-dark(#56565b, var(--text-secondary));
		transition:
			color var(--dur-micro) var(--ease-out),
			background-color var(--dur-micro) var(--ease-out);
	}

	.lang__link:hover {
		color: var(--text);
	}

	.lang__link[aria-current='page'] {
		color: var(--text);
		background: var(--bg);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
	}
</style>
