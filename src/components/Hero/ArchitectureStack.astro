---
/**
 * The layers of a business system in CSS 3D. As the hero scrolls away the
 * layers separate into an exploded view (`--progress` from the hero).
 */
interface Props {
	layers: readonly string[];
	label: string;
}

const { layers, label } = Astro.props;
const coreIndex = Math.min(2, layers.length - 1);
---

<figure class="stack" role="img" aria-label={label}>
	<div class="stack__scene" aria-hidden="true">
		{
			layers.map((layer, index) => (
				<div
					class:list={['stack__layer', { 'is-core': index === coreIndex }]}
					style={`--z: ${layers.length - 1 - index}`}
				>
					<span class="stack__name">{layer}</span>
				</div>
			))
		}
	</div>
</figure>

<style>
	.stack {
		--gap: clamp(1.75rem, 1rem + 3vw, 3.75rem);

		display: grid;
		place-items: center;
		width: min(100%, 44rem);
		aspect-ratio: 16 / 11;
		margin-inline: auto;
		perspective: 2000px;
	}

	.stack__scene {
		position: relative;
		width: 58%;
		aspect-ratio: 1;
		transform-style: preserve-3d;
		transform: rotateX(60deg) rotateZ(-45deg);
	}

	.stack__layer {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		padding: 7% 8%;
		border-radius: 12%;
		background: light-dark(rgb(255 255 255 / 0.92), rgb(38 38 41 / 0.9));
		box-shadow:
			inset 0 0 0 1px var(--line-soft),
			0 30px 50px -20px var(--shadow-color);
		/* Exploded view: layers drift apart as the hero scrolls */
		transform: translateZ(calc((var(--z) - 1.5) * var(--gap) * (1 + var(--progress, 0) * 1.6)));
		animation: settle 1.4s var(--ease-out) both;
		animation-delay: calc(200ms + var(--z) * 90ms);
	}

	.stack__layer.is-core {
		background: linear-gradient(135deg, #3d8bff, var(--accent-fill));
		box-shadow: 0 30px 60px -20px rgb(10 108 230 / 0.55);
	}

	.stack__name {
		font-size: clamp(0.6875rem, 0.55rem + 0.5vw, 0.9375rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text-secondary);
	}

	.is-core .stack__name {
		color: #fff;
	}

	@keyframes settle {
		from {
			opacity: 0;
			transform: translateZ(calc((var(--z) - 1.5) * var(--gap) * 2.4));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stack__layer {
			transform: translateZ(calc((var(--z) - 1.5) * var(--gap)));
		}
	}
</style>
