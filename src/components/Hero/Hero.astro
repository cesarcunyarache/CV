---
import ArchitectureStack from './ArchitectureStack.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
const { profile, contact } = data;
const [firstName, ...rest] = profile.shortName.split(' ');
---

<section class="hero" id="top" data-progress="exit" aria-labelledby="hero-title">
	<div class="hero__grid" aria-hidden="true"></div>
	<div class="hero__glow" aria-hidden="true"></div>

	<div class="hero__inner container">
		<div class="hero__meta label">
			<span>{profile.role}</span>
			<span class="hero__meta-sep" aria-hidden="true"></span>
			<span>{profile.location.city}, {profile.location.country}</span>
			<span class="hero__coords" aria-hidden="true">{profile.location.coordinates}</span>
		</div>

		<div class="hero__content">
			<h1 class="hero__title" id="hero-title">
				<span class="hero__line"><span>{firstName}</span></span>{' '}
				<span class="hero__line hero__line--serif"><span class="serif">{rest.join(' ')}</span></span>
			</h1>

			<div class="hero__copy">
				<p class="hero__headline">{profile.headline}</p>
				<p class="hero__summary">{profile.summary}</p>

				<div class="hero__actions">
					<Button href="#work" variant="primary" icon="arrow-down" magnetic>{t.hero.ctaWork}</Button>
					<Button href="#contact" magnetic>{t.hero.ctaContact}</Button>
					<div class="hero__social">
						<a
							class="hero__social-link"
							href={contact.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`LinkedIn ${t.a11y.opensInNewTab}`}
						>
							<Icon name="linkedin" />
						</a>
						<a
							class="hero__social-link"
							href={contact.github}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={`GitHub ${t.a11y.opensInNewTab}`}
						>
							<Icon name="github" />
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="hero__visual">
			<ArchitectureStack layers={t.hero.layers} label={t.a11y.architectureDiagram} />
			<ul class="hero__tags" aria-hidden="true" data-parallax-pointer>
				{profile.focusTags.map((tag, index) => <li style={`--i: ${index}`}>{tag}</li>)}
			</ul>
		</div>

		<div class="hero__footer">
			{
				profile.availability && (
					<p class="hero__status">
						<span class="hero__status-dot" aria-hidden="true" />
						<span class="label">{t.hero.currently}</span>
						<span>{profile.availability}</span>
					</p>
				)
			}
			<a class="hero__scroll label" href="#about">
				{t.hero.scroll}
				<span class="hero__scroll-line" aria-hidden="true"></span>
			</a>
		</div>
	</div>
</section>

<style>
	.hero {
		--progress: 0;

		position: relative;
		min-height: 100svh;
		display: flex;
		overflow: clip;
		isolation: isolate;
	}

	/* Technical grid fading out from the centre */
	.hero__grid {
		position: absolute;
		inset: 0;
		z-index: -2;
		background:
			linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 5rem 5rem,
			linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 5rem 5rem;
		mask-image: radial-gradient(ellipse 70% 60% at 65% 45%, #000 20%, transparent 75%);
		transform: translate3d(0, calc(var(--progress) * 12vh), 0);
	}

	.hero__glow {
		position: absolute;
		z-index: -1;
		right: -10vw;
		top: 10vh;
		width: 60vw;
		aspect-ratio: 1;
		background: radial-gradient(circle, rgb(255 106 61 / 0.12), transparent 60%);
		transform: translate3d(0, calc(var(--progress) * -10vh), 0);
	}

	.hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: auto 1fr auto;
		gap: 2rem;
		padding-top: calc(var(--header-height) + 2.5rem);
		padding-bottom: 2rem;
	}

	.hero__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		animation: fade-up 1s var(--ease-out) 200ms both;
	}

	.hero__meta-sep {
		width: 2rem;
		height: 1px;
		background: var(--line-strong);
	}

	.hero__coords {
		color: var(--text-dim);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		display: grid;
		align-content: center;
		gap: clamp(2rem, 1rem + 3vw, 3.5rem);
		transform: translate3d(0, calc(var(--progress) * -8vh), 0);
		opacity: calc(1 - var(--progress) * 1.2);
	}

	.hero__title {
		font-size: var(--step-display);
		line-height: 0.88;
		letter-spacing: -0.055em;
		font-weight: 500;
	}

	.hero__line {
		display: block;
		overflow: hidden;
		padding-bottom: 0.08em;
	}

	.hero__line > span {
		display: inline-block;
		animation: line-up 1.2s var(--ease-out) both;
	}

	.hero__line--serif {
		padding-left: 0.6em;
		color: var(--text-muted);
	}

	.hero__line--serif > span {
		animation-delay: 120ms;
		letter-spacing: -0.03em;
	}

	.hero__copy {
		display: grid;
		gap: 1.25rem;
		max-width: 34rem;
		animation: fade-up 1s var(--ease-out) 450ms both;
	}

	.hero__headline {
		font-size: var(--step-h3);
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.025em;
	}

	.hero__summary {
		color: var(--text-muted);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.75rem;
	}

	.hero__social {
		display: flex;
		gap: 0.25rem;
	}

	.hero__social-link {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		color: var(--text-muted);
		transition:
			color var(--dur-micro) var(--ease-out),
			background-color var(--dur-micro) var(--ease-out),
			transform var(--dur-component) var(--ease-out);
	}

	.hero__social-link:hover {
		color: var(--text);
		background: rgb(255 255 255 / 0.06);
		transform: translateY(-2px);
	}

	.hero__visual {
		position: relative;
		display: grid;
		place-items: center;
		max-width: 26rem;
		width: 100%;
		margin-inline: auto;
	}

	.hero__tags {
		display: none;
	}

	.hero__footer {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.5rem;
		animation: fade-up 1s var(--ease-out) 700ms both;
	}

	.hero__status {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.75rem;
		font-size: var(--step-meta);
		color: var(--text-muted);
	}

	.hero__status-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #4ade80;
		box-shadow: 0 0 0 4px rgb(74 222 128 / 0.15);
	}

	.hero__scroll {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 2.75rem;
		transition: color var(--dur-micro) var(--ease-out);
	}

	.hero__scroll:hover {
		color: var(--text);
	}

	.hero__scroll-line {
		position: relative;
		width: 3.5rem;
		height: 1px;
		background: var(--line-strong);
		overflow: hidden;
	}

	.hero__scroll-line::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--accent);
		animation: scan 2.4s var(--ease-in-out) infinite;
	}

	@keyframes line-up {
		from {
			transform: translate3d(0, 105%, 0);
		}
	}

	@keyframes fade-up {
		from {
			opacity: 0;
			transform: translate3d(0, 1.5rem, 0);
		}
	}

	@keyframes scan {
		from {
			transform: translateX(-100%);
		}
		to {
			transform: translateX(100%);
		}
	}

	@media (min-width: 64rem) {
		.hero__inner {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
			grid-template-rows: auto 1fr auto;
			column-gap: 2rem;
		}

		.hero__meta,
		.hero__footer {
			grid-column: 1 / -1;
		}

		.hero__visual {
			max-width: none;
			align-self: center;
		}

		/* Floating technical tags around the stack, at different depths */
		.hero__tags {
			--px: 0;
			--py: 0;

			position: absolute;
			inset: 0;
			display: block;
			pointer-events: none;
		}

		.hero__tags li {
			position: absolute;
			font-family: var(--font-mono);
			font-size: var(--step-label);
			letter-spacing: 0.14em;
			color: var(--text-dim);
			padding: 0.35rem 0.6rem;
			border: 1px solid var(--line);
			border-radius: 999px;
			background: rgb(10 10 11 / 0.6);
			transform: translate3d(
				calc(var(--px) * (var(--i) + 2) * -5px),
				calc(var(--py) * (var(--i) + 2) * -5px),
				0
			);
			transition: transform 1s var(--ease-out);
			animation: fade-up 1s var(--ease-out) both;
			animation-delay: calc(900ms + var(--i) * 90ms);
		}

		.hero__tags li:nth-child(1) { top: 6%; left: 8%; }
		.hero__tags li:nth-child(2) { top: 16%; right: 0; }
		.hero__tags li:nth-child(3) { top: 48%; left: -4%; }
		.hero__tags li:nth-child(4) { top: 40%; right: -6%; }
		.hero__tags li:nth-child(5) { bottom: 8%; left: 14%; }
		.hero__tags li:nth-child(6) { bottom: 2%; right: 18%; }
	}

	@media (max-width: 63.99rem) {
		.hero__visual {
			order: -1;
			position: absolute;
			top: 18%;
			right: -18%;
			width: 75%;
			max-width: 24rem;
			opacity: 0.4;
			pointer-events: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__content,
		.hero__grid,
		.hero__glow {
			transform: none;
			opacity: 1;
		}
	}
</style>
