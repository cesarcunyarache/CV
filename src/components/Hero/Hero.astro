---
import ArchitectureStack from './ArchitectureStack.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
const { profile, contact } = data;
const social = [
	{ label: 'LinkedIn', href: contact.linkedin, icon: 'linkedin' as const },
	{ label: 'GitHub', href: contact.github, icon: 'github' as const },
];

/*
 * Scroll scene: the section is taller than the viewport and its content is
 * sticky. `--progress` (0 → 1) drives two phases:
 *   1. the intro text fades out while the stack rises to the centre;
 *   2. the stack separates into an exploded view.
 */
---

<section class="hero" id="top" data-progress="sticky" aria-labelledby="hero-title">
	<div class="hero__stage">
		<div class="hero__intro container">
			{
				profile.availability && (
					<p class="hero__status">
						<span class="hero__status-dot" aria-hidden="true" />
						{profile.availability}
					</p>
				)
			}
			<p class="hero__eyebrow">
				{profile.role} · {profile.location.city}, {profile.location.country}
			</p>
			<h1 class="hero__title" id="hero-title">{profile.shortName}</h1>
			<p class="hero__headline">{profile.headline}</p>
			<p class="hero__summary">{profile.summary}</p>

			<div class="hero__actions">
				<Button href="#work" size="large">{t.hero.ctaWork}</Button>
				<a class="link hero__link" href="#contact">
					{t.hero.ctaContact}
					<Icon name="chevron-right" size={18} class="chevron" />
				</a>
				<ul class="hero__social">
					{
						social.map((item) => (
							<li>
								<a
									href={item.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${item.label} ${t.a11y.opensInNewTab}`}
								>
									<Icon name={item.icon} size={20} />
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="hero__visual">
			<ArchitectureStack layers={t.hero.layers} label={t.a11y.architectureDiagram} />
		</div>

		<p class="hero__hint" aria-hidden="true">
			{t.hero.scrollHint}
			<span class="hero__hint-line"></span>
		</p>
	</div>
</section>

<style>
	.hero {
		--progress: 0;
		/* Phase 1: intro out, stack up — first 35% of the scroll */
		--intro: clamp(0, calc(var(--progress) / 0.35), 1);
		/* Phase 2: exploded view — from 25% to 80% */
		--explode: clamp(0, calc((var(--progress) - 0.25) / 0.55), 1);

		position: relative;
		text-align: center;
	}

	/* Extra scroll length for the scene only when JS drives it */
	:global(.js) .hero {
		height: 230svh;
	}

	.hero__stage {
		position: sticky;
		top: 0;
		display: flex;
		flex-direction: column;
		height: 100svh;
		padding-top: calc(var(--header-height) + clamp(1.5rem, 5svh, 4rem));
		padding-bottom: 4.5rem;
		overflow: clip;
	}

	.hero__intro {
		display: flex;
		flex-direction: column;
		align-items: center;
		transform: translate3d(0, calc(var(--intro) * -6svh), 0) scale(calc(1 - var(--intro) * 0.06));
		opacity: calc(1 - var(--intro) * 1.4);
	}

	.hero__intro > * {
		animation: rise 1.1s var(--ease-out) backwards;
	}

	.hero__intro > :nth-child(2) { animation-delay: 60ms; }
	.hero__intro > :nth-child(3) { animation-delay: 120ms; }
	.hero__intro > :nth-child(4) { animation-delay: 200ms; }
	.hero__intro > :nth-child(5) { animation-delay: 260ms; }
	.hero__intro > :nth-child(n + 6) { animation-delay: 320ms; }

	.hero__status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: clamp(1rem, 3svh, 1.75rem);
		padding: 0.35rem 0.9rem 0.35rem 0.75rem;
		border-radius: 999px;
		background: var(--surface);
		font-size: var(--fs-small);
		text-align: left;
		color: var(--text-secondary);
	}

	.hero__status-dot {
		flex-shrink: 0;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--success);
	}

	.hero__eyebrow {
		font-size: var(--fs-subtitle);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--text-secondary);
	}

	.hero__title {
		margin-top: 0.4rem;
		font-size: min(var(--fs-hero), 12svh);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.035em;
	}

	.hero__headline {
		max-width: 24ch;
		margin-top: clamp(0.75rem, 2svh, 1.25rem);
		font-size: min(var(--fs-title), 4.6svh);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.024em;
		background: linear-gradient(180deg, var(--text) 30%, var(--text-secondary));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__summary {
		max-width: 38rem;
		margin-top: 0.9rem;
		font-size: var(--fs-lead);
		color: var(--text-secondary);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.75rem 1.75rem;
		margin-top: clamp(1.25rem, 3svh, 2rem);
	}

	.hero__link {
		font-size: var(--fs-lead);
	}

	.hero__social {
		display: flex;
		gap: 0.25rem;
	}

	.hero__social a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		color: var(--text-secondary);
		transition:
			color var(--dur-micro) var(--ease-out),
			background-color var(--dur-micro) var(--ease-out);
	}

	.hero__social a:hover {
		color: var(--text);
		background: var(--surface);
	}

	/* The stack takes the remaining height, then rises and grows in phase 1 */
	.hero__visual {
		flex: 1;
		min-height: 0;
		container-type: size;
		transform: translate3d(calc(var(--intro) * var(--shift, 0px)), calc(var(--intro) * var(--rise, -24svh)), 0)
			scale(calc(1 + var(--intro) * var(--grow, 0.55)));
	}

	.hero__hint {
		position: absolute;
		left: 50%;
		bottom: 1.25rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		font-size: var(--fs-caption);
		color: var(--text-secondary);
		translate: -50% 0;
		opacity: calc(1 - var(--intro) * 3);
		animation: rise 1s var(--ease-out) 1.2s backwards;
	}

	.hero__hint-line {
		position: relative;
		width: 1px;
		height: 2rem;
		background: var(--line);
		overflow: hidden;
	}

	.hero__hint-line::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--text);
		animation: drip 2s var(--ease-out) infinite;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translate3d(0, 1.25rem, 0);
		}
	}

	@keyframes drip {
		from {
			transform: translateY(-100%);
		}
		to {
			transform: translateY(100%);
		}
	}

	/*
	 * Desktop: text on the left, the stack fills the right column. While
	 * scrolling, the text fades and the stack glides to the centre.
	 */
	@media (min-width: 64rem) {
		.hero {
			--shift: -22vw;
			--rise: 0px;
			--grow: 0.2;

			text-align: left;
		}

		.hero__stage {
			display: grid;
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			align-items: center;
			column-gap: 2rem;
			padding-inline: max(var(--gutter), (100vw - var(--container)) / 2 + var(--gutter));
		}

		.hero__intro {
			align-items: flex-start;
			padding-inline: 0;
			transform: translate3d(calc(var(--intro) * -4vw), 0, 0);
		}

		.hero__actions {
			justify-content: flex-start;
		}

		.hero__visual {
			height: 100%;
		}
	}

	/* Short / narrow screens: the intro is taller, so the stack travels further */
	@media (max-width: 47.99rem) {
		.hero {
			--rise: -30svh;
			--grow: 0.9;
		}

		:global(.js) .hero {
			height: 210svh;
		}

		.hero__stage {
			padding-bottom: 1.5rem;
		}

		.hero__hint {
			display: none;
		}
	}

	/* No scroll scene: normal-height hero with a static stack */
	@media (prefers-reduced-motion: reduce) {
		:global(.js) .hero {
			height: auto;
		}

		.hero__stage {
			position: relative;
			height: auto;
			min-height: 100svh;
		}

		.hero__visual {
			flex: none;
			height: 60svh;
		}

		.hero__intro,
		.hero__visual {
			transform: none;
			opacity: 1;
		}

		.hero__hint {
			display: none;
		}
	}
</style>
