---
import ArchitectureStack from './ArchitectureStack.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
const { profile, contact } = data;
const social = [
	{ label: 'LinkedIn', href: contact.linkedin, icon: 'linkedin' as const },
	{ label: 'GitHub', href: contact.github, icon: 'github' as const },
];
---

<section class="hero" id="top" data-progress="exit" aria-labelledby="hero-title">
	<div class="hero__inner container">
		{
			profile.availability && (
				<p class="hero__status">
					<span class="hero__status-dot" aria-hidden="true" />
					{profile.availability}
				</p>
			)
		}
		<p class="hero__eyebrow">
			{profile.role} · {profile.location.city}, {profile.location.country}
		</p>
		<h1 class="hero__title" id="hero-title">{profile.shortName}</h1>
		<p class="hero__headline">{profile.headline}</p>
		<p class="hero__summary">{profile.summary}</p>

		<div class="hero__actions">
			<Button href="#work" size="large">{t.hero.ctaWork}</Button>
			<a class="link hero__link" href="#contact">
				{t.hero.ctaContact}
				<Icon name="chevron-right" size={18} class="chevron" />
			</a>
		</div>

		<ul class="hero__social">
			{
				social.map((item) => (
					<li>
						<a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={`${item.label} ${t.a11y.opensInNewTab}`}>
							<Icon name={item.icon} size={20} />
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<div class="hero__visual">
		<ArchitectureStack layers={t.hero.layers} label={t.a11y.architectureDiagram} />
	</div>
</section>

<style>
	.hero {
		--progress: 0;

		position: relative;
		padding-top: calc(var(--header-height) + clamp(3rem, 2rem + 5vh, 6rem));
		overflow: clip;
		text-align: center;
	}

	.hero__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		/* Content eases away as the page scrolls */
		transform: translate3d(0, calc(var(--progress) * -10vh), 0);
		opacity: calc(1 - var(--progress) * 1.6);
	}

	.hero__inner > * {
		animation: rise 1.1s var(--ease-out) both;
	}

	.hero__inner > :nth-child(2) { animation-delay: 60ms; }
	.hero__inner > :nth-child(3) { animation-delay: 120ms; }
	.hero__inner > :nth-child(4) { animation-delay: 200ms; }
	.hero__inner > :nth-child(5) { animation-delay: 260ms; }
	.hero__inner > :nth-child(n + 6) { animation-delay: 320ms; }

	.hero__status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 2rem;
		padding: 0.4rem 0.9rem 0.4rem 0.75rem;
		border-radius: 999px;
		background: var(--surface);
		font-size: var(--fs-small);
		text-align: left;
		color: var(--text-secondary);
	}

	.hero__status-dot {
		flex-shrink: 0;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--success);
	}

	.hero__eyebrow {
		font-size: var(--fs-subtitle);
		font-weight: 600;
		letter-spacing: -0.015em;
		color: var(--text-secondary);
	}

	.hero__title {
		margin-top: 0.5rem;
		font-size: var(--fs-hero);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.035em;
	}

	.hero__headline {
		max-width: 24ch;
		margin-top: 1.5rem;
		font-size: var(--fs-title);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.024em;
		/* Subtle vertical tone, not a colorful gradient */
		background: linear-gradient(180deg, var(--text) 30%, var(--text-secondary));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__summary {
		max-width: 38rem;
		margin-top: 1.25rem;
		font-size: var(--fs-lead);
		color: var(--text-secondary);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 1rem 2rem;
		margin-top: 2.25rem;
	}

	.hero__link {
		font-size: var(--fs-lead);
	}

	.hero__social {
		display: flex;
		gap: 0.25rem;
		margin-top: 1.5rem;
	}

	.hero__social a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		color: var(--text-secondary);
		transition:
			color var(--dur-micro) var(--ease-out),
			background-color var(--dur-micro) var(--ease-out);
	}

	.hero__social a:hover {
		color: var(--text);
		background: var(--surface);
	}

	.hero__visual {
		margin-top: clamp(1rem, 4vh, 3rem);
		padding-inline: var(--gutter);
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translate3d(0, 1.25rem, 0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__inner {
			transform: none;
			opacity: 1;
		}
	}
</style>
