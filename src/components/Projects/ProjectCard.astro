---
import { Image } from 'astro:assets';
import ProjectPreview from './ProjectPreview.astro';
import Icon from '../ui/Icon.astro';
import type { ResolvedPortfolio, UI } from '../../data';

interface Props {
	project: ResolvedPortfolio['projects'][number];
	index: number;
	t: UI;
}

const { project, index, t } = Astro.props;
const titleId = `project-${project.slug}`;
const links = [
	project.liveUrl && { href: project.liveUrl, label: t.work.live },
	project.repositoryUrl && { href: project.repositoryUrl, label: t.work.repository },
].filter(Boolean) as { href: string; label: string }[];
const meta = [project.category, project.year].filter(Boolean).join(' · ');
---

<article class="card" aria-labelledby={titleId} data-tilt data-spotlight>
	<div class="card__body">
		<p class="card__meta">
			{meta}
			{project.placeholder && <span class="card__badge">{t.work.placeholder}</span>}
		</p>
		<h3 class="card__title" id={titleId}>{project.title}</h3>
		<p class="card__description">{project.description}</p>

		{
			project.highlights && project.highlights.length > 0 && (
				<ul class="card__highlights">
					{project.highlights.map((highlight) => (
						<li>{highlight}</li>
					))}
				</ul>
			)
		}

		<p class="card__tech">{project.technologies.join(' · ')}</p>

		{
			links.length > 0 && (
				<div class="card__links">
					{links.map((link) => (
						<a class="link" href={link.href} target="_blank" rel="noopener noreferrer">
							{link.label}
							<span class="sr-only">{t.a11y.opensInNewTab}</span>
							<Icon name="chevron-right" size={16} class="chevron" />
						</a>
					))}
				</div>
			)
		}
	</div>

	<div class="card__media">
		{
			project.image ? (
				<Image
					class="card__image"
					src={project.image}
					alt={project.imageAlt ?? ''}
					widths={[480, 800, 1200]}
					sizes="(min-width: 64rem) 40vw, 100vw"
					loading="lazy"
				/>
			) : (
				<ProjectPreview index={index} technologies={project.technologies} />
			)
		}
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border-radius: var(--radius-lg);
		background: var(--surface);
		overflow: hidden;
	}

	.card__body {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem) clamp(1.5rem, 1rem + 1.5vw, 2.75rem) 0;
	}

	.card__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem;
		font-size: var(--fs-small);
		font-weight: 600;
		color: var(--text-secondary);
	}

	.card__badge {
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		background: light-dark(#fff4d6, #3a2f12);
		color: light-dark(#8a5a00, #ffcf5c);
		font-size: var(--fs-caption);
	}

	.card__title {
		font-size: var(--fs-title);
		letter-spacing: -0.025em;
	}

	.card__description {
		max-width: 44ch;
		font-size: var(--fs-body);
		color: var(--text-secondary);
	}

	.card__highlights {
		display: grid;
		gap: 0.3rem;
		font-size: var(--fs-small);
	}

	.card__highlights li::before {
		content: '— ';
		color: var(--text-secondary);
	}

	.card__tech {
		font-size: var(--fs-small);
		color: var(--text-secondary);
	}

	.card__links {
		display: flex;
		gap: 1.5rem;
	}

	.card__media {
		position: relative;
		flex: 1;
		min-height: 14rem;
		margin-top: 1.5rem;
		overflow: hidden;
	}

	.card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform var(--dur-section) var(--ease-out);
	}

	/* Media lifts slightly on hover */
	@media (hover: hover) {
		.card:hover .card__image,
		.card:hover :global(.preview__diagram) {
			transform: scale(1.04);
		}
	}
</style>
