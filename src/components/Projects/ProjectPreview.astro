---
/**
 * Generated visual used when a project has no image: the project's
 * technologies as a small, clean system diagram.
 */
interface Props {
	index: number;
	technologies: string[];
}

const { index, technologies } = Astro.props;
const [core = '', ...modules] = technologies.slice(0, 4);
---

<div class="preview" aria-hidden="true">
	<span class="preview__index">{String(index).padStart(2, '0')}</span>
	<div class="preview__diagram">
		<span class="preview__core">{core}</span>
		{
			modules.length > 0 && (
				<div class="preview__modules">
					{modules.map((module) => (
						<span>{module}</span>
					))}
				</div>
			)
		}
	</div>
</div>

<style>
	.preview {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: radial-gradient(120% 90% at 50% 110%, light-dark(#dfe8f7, #10233d), transparent 70%);
		overflow: hidden;
	}

	.preview__index {
		position: absolute;
		right: 1.25rem;
		bottom: -0.12em;
		font-size: clamp(6rem, 5rem + 5vw, 10rem);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.06em;
		color: var(--line-soft);
	}

	.preview__diagram {
		position: relative;
		display: flex;
		align-items: center;
		gap: 2rem;
		transition: transform var(--dur-section) var(--ease-out);
	}

	.preview__diagram span {
		padding: 0.6rem 1rem;
		border-radius: 0.75rem;
		background: var(--surface-raised);
		box-shadow: 0 10px 30px -12px var(--shadow-color), inset 0 0 0 1px var(--line-soft);
		font-size: var(--fs-small);
		font-weight: 600;
		white-space: nowrap;
	}

	.preview__diagram .preview__core {
		position: relative;
		background: var(--accent-fill);
		color: var(--on-accent);
		box-shadow: 0 14px 30px -12px rgb(10 108 230 / 0.6);
	}

	.preview__core:not(:only-child)::after {
		content: '';
		position: absolute;
		left: 100%;
		top: 50%;
		width: 2rem;
		height: 1.5px;
		background: var(--line);
	}

	.preview__modules {
		display: grid;
		gap: 0.6rem;
	}
</style>
