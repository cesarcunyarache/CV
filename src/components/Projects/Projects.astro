---
import ProjectCard from './ProjectCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
// Featured projects first, then the rest in their original order.
const projects = [...data.projects].sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)));
---

<section class="work section--alt" id="work" aria-labelledby="work-title" data-horizontal data-progress="sticky">
	<div class="work__sticky">
		<div class="work__head container">
			<SectionHeading title={t.headings.work.title} subtitle={t.headings.work.subtitle} id="work-title" />
		</div>

		<div class="work__viewport">
			{
				projects.length > 0 ? (
					<ol class="work__track" data-horizontal-track data-reveal-group>
						{projects.map((project, i) => (
							<li class="work__item" data-reveal>
								<ProjectCard project={project} index={i + 1} t={t} />
							</li>
						))}
					</ol>
				) : (
					<p class="work__empty container">{t.work.empty}</p>
				)
			}
		</div>

		<div class="work__progress container" aria-hidden="true">
			<span class="work__progress-bar"></span>
		</div>
	</div>
</section>

<style>
	.work {
		--progress: 0;
		--distance: 0px;
		--edge: max(var(--gutter), (100vw - var(--container)) / 2 + var(--gutter));

		position: relative;
		padding-block: var(--space-section);
		overflow-x: clip;
	}

	.work__track {
		display: grid;
		gap: 1.25rem;
		padding-inline: var(--gutter);
		max-width: var(--container);
		margin-inline: auto;
	}

	.work__progress {
		display: none;
	}

	.work__empty {
		font-size: var(--fs-lead);
		color: var(--text-secondary);
	}

	@media (min-width: 48rem) {
		.work__track {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Desktop with JS: vertical scroll moves the cards sideways (sticky, native scroll) */
	@media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
		:global(.js) .work {
			padding-block: 0;
		}

		:global(.js) .work__sticky {
			position: sticky;
			top: 0;
			height: 100svh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding-top: var(--header-height);
			overflow: hidden;
		}

		/* Compact headline so heading + cards fit one viewport */
		:global(.js) .work__head :global(.heading) {
			max-width: 32ch;
			margin-bottom: 2rem;
			font-size: clamp(2rem, 1.2rem + 2.2vw, 3.25rem);
		}

		:global(.js) .work__track {
			display: flex;
			gap: 1.25rem;
			width: max-content;
			max-width: none;
			margin: 0;
			padding-inline: var(--edge);
			transform: translate3d(calc(var(--progress) * var(--distance) * -1), 0, 0);
			will-change: transform;
		}

		:global(.js) .work__item {
			width: clamp(26rem, 40vw, 38rem);
			height: min(58svh, 38rem);
		}

		:global(.js) .work__progress {
			display: block;
			margin-top: 2rem;
		}

		.work__progress-bar {
			display: block;
			height: 3px;
			border-radius: 2px;
			background: var(--line);
			overflow: hidden;
		}

		.work__progress-bar::after {
			content: '';
			display: block;
			height: 100%;
			width: 100%;
			background: var(--text);
			transform-origin: left;
			transform: scaleX(var(--progress));
		}
	}
</style>
