---
import SectionHeading from '../ui/SectionHeading.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
const technologyGroups = data.skills.filter((group) => group.kind === 'technologies');
const conceptGroups = data.skills.filter((group) => group.kind === 'concepts');
---

<section class="skills section" id="stack" aria-labelledby="stack-title">
	<div class="container">
		<SectionHeading title={t.headings.stack.title} subtitle={t.headings.stack.subtitle} id="stack-title" />

		<div class="skills__bento" data-reveal-group>
			{
				technologyGroups.map((group) => (
					<div class="skills__group tile" data-reveal>
						<h3 class="skills__group-title">{group.title}</h3>
						<ul class="skills__tech">
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<h3 class="skills__subheading" data-reveal>{t.stack.principles}</h3>
		<div class="skills__concepts">
			{
				conceptGroups.map((group) => (
					<div class="skills__concept-group" data-reveal>
						<h4 class="skills__group-title">{group.title}</h4>
						<ul class="skills__concept-list">
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.skills__bento {
		display: grid;
		gap: 1rem;
	}

	.skills__group {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.skills__group-title {
		font-size: var(--fs-small);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text-secondary);
	}

	.skills__tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.1em 0.5em;
		margin-top: auto;
		font-size: var(--fs-title);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.skills__tech li {
		transition: color var(--dur-micro) var(--ease-out);
	}

	/* Hovering one technology dims the rest of its group */
	@media (hover: hover) {
		.skills__tech:hover li:not(:hover) {
			color: var(--text-secondary);
		}
	}

	.skills__subheading {
		margin-top: clamp(4rem, 3rem + 4vw, 7rem);
		margin-bottom: 1.5rem;
		font-size: var(--fs-title);
		letter-spacing: -0.025em;
	}

	.skills__concepts {
		display: grid;
		gap: 2.5rem;
	}

	.skills__concept-list {
		margin-top: 0.75rem;
	}

	.skills__concept-list li {
		padding-block: 0.85rem;
		border-bottom: 1px solid var(--line);
		font-size: var(--fs-lead);
	}

	@media (min-width: 48rem) {
		.skills__group {
			min-height: 14rem;
		}

		.skills__bento,
		.skills__concepts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.skills__concepts {
			column-gap: 3rem;
		}
	}

	@media (min-width: 64rem) {
		/* Bento: the larger groups take more width */
		.skills__bento {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.skills__group:nth-child(4n + 1),
		.skills__group:nth-child(4n) {
			grid-column: span 2;
		}

		.skills__group:nth-child(4n + 2),
		.skills__group:nth-child(4n + 3) {
			grid-column: span 4;
		}
	}
</style>
