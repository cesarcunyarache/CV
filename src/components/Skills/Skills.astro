---
import TechMarquee from './TechMarquee.astro';
import BrandLogo from '../ui/BrandLogo.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { Content } from '../../data';

interface Props {
	content: Content;
}

const { data, t } = Astro.props.content;
const technologyGroups = data.skills.filter((group) => group.kind === 'technologies');
const conceptGroups = data.skills.filter((group) => group.kind === 'concepts');
const allTechnologies = technologyGroups.flatMap((group) => group.items);
---

<section class="skills section" id="stack" aria-labelledby="stack-title">
	<div class="container">
		<SectionHeading title={t.headings.stack.title} subtitle={t.headings.stack.subtitle} id="stack-title" />
	</div>

	<TechMarquee items={allTechnologies} />

	<div class="container">
		<div class="skills__bento" data-reveal-group>
			{
				technologyGroups.map((group) => (
					<div class="skills__group tile" data-reveal data-spotlight>
						<h3 class="skills__group-title">{group.title}</h3>
						<ul class="skills__tech">
							{group.items.map((item, k) => (
								<li class="tech" style={`--k: ${k}`}>
									<BrandLogo name={item} size={26} class="tech__logo" />
									{item}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<h3 class="skills__subheading" data-reveal>{t.stack.principles}</h3>
		<div class="skills__concepts">
			{
				conceptGroups.map((group) => (
					<div class="skills__concept-group" data-reveal>
						<h4 class="skills__group-title">{group.title}</h4>
						<ul class="skills__concept-list">
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.skills__bento {
		display: grid;
		gap: 1rem;
	}

	.skills__group {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.skills__group-title {
		font-size: var(--fs-small);
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--text-secondary);
	}

	.skills__tech {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: auto;
	}

	/* Logo chips; brand colour on the logo, lift on hover */
	.tech {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.55rem 1rem 0.55rem 0.7rem;
		border-radius: 999px;
		background: var(--bg);
		box-shadow: inset 0 0 0 1px var(--line-soft);
		font-size: var(--fs-lead);
		font-weight: 600;
		letter-spacing: -0.02em;
		transition:
			transform var(--dur-component) var(--ease-out),
			box-shadow var(--dur-component) var(--ease-out),
			opacity 600ms var(--ease-out),
			scale 600ms var(--ease-out);
		transition-delay: 0ms, 0ms, calc(250ms + var(--k) * 70ms), calc(250ms + var(--k) * 70ms);
	}

	.tech :global(.tech__logo) {
		color: var(--brand, var(--text));
		transition: transform var(--dur-component) var(--ease-out);
	}

	@media (hover: hover) {
		.tech:hover {
			transform: translateY(-3px);
			box-shadow:
				inset 0 0 0 1px var(--line-soft),
				0 12px 24px -12px var(--shadow-color);
		}

		.tech:hover :global(.tech__logo) {
			transform: rotate(-8deg) scale(1.12);
		}
	}

	/* Chips pop in one by one once their tile is revealed */
	:global(.js) .skills__group:not(:global(.is-visible)) .tech {
		opacity: 0;
		scale: 0.85;
	}

	.skills__subheading {
		margin-top: clamp(4rem, 3rem + 4vw, 7rem);
		margin-bottom: 1.5rem;
		font-size: var(--fs-title);
		letter-spacing: -0.025em;
	}

	.skills__concepts {
		display: grid;
		gap: 2.5rem;
	}

	.skills__concept-list {
		margin-top: 0.75rem;
	}

	.skills__concept-list li {
		padding-block: 0.85rem;
		border-bottom: 1px solid var(--line);
		font-size: var(--fs-lead);
		transition: translate var(--dur-component) var(--ease-out);
	}

	@media (hover: hover) {
		.skills__concept-list li:hover {
			translate: 0.4rem 0;
		}
	}

	@media (min-width: 48rem) {
		.skills__group {
			min-height: 14rem;
		}

		.skills__bento,
		.skills__concepts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.skills__concepts {
			column-gap: 3rem;
		}
	}

	@media (min-width: 64rem) {
		/* Bento: the larger groups take more width */
		.skills__bento {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.skills__group:nth-child(4n + 1),
		.skills__group:nth-child(4n) {
			grid-column: span 2;
		}

		.skills__group:nth-child(4n + 2),
		.skills__group:nth-child(4n + 3) {
			grid-column: span 4;
		}
	}
</style>
