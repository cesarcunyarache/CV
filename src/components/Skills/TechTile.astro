---
interface Props {
	name: string;
	symbol?: string;
	number: number;
	group: string;
}

const { name, symbol, number, group } = Astro.props;
---

<li class="tile" data-reveal>
	<span class="tile__number" aria-hidden="true">{String(number).padStart(2, '0')}</span>
	<span class="tile__symbol" aria-hidden="true">{symbol ?? name.slice(0, 2)}</span>
	<span class="tile__name">{name}</span>
	<span class="tile__group" aria-hidden="true">{group}</span>
</li>

<style>
	.tile {
		position: relative;
		display: grid;
		grid-template-rows: auto 1fr auto;
		aspect-ratio: 1;
		padding: 0.75rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		overflow: hidden;
		transition:
			transform var(--dur-component) var(--ease-out),
			border-color var(--dur-component) var(--ease-out),
			background-color var(--dur-component) var(--ease-out);
	}

	.tile::before {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 50% 120%, rgb(255 106 61 / 0.3), transparent 60%);
		opacity: 0;
		transition: opacity var(--dur-component) var(--ease-out);
	}

	.tile:hover {
		transform: translateY(-4px);
		border-color: rgb(255 106 61 / 0.5);
		background: var(--surface-hover);
	}

	.tile:hover::before {
		opacity: 1;
	}

	.tile__number,
	.tile__group {
		position: relative;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.1em;
		color: var(--text-dim);
	}

	.tile__symbol {
		position: relative;
		align-self: center;
		justify-self: center;
		font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
		font-weight: 500;
		letter-spacing: -0.04em;
		transition:
			color var(--dur-micro) var(--ease-out),
			transform var(--dur-component) var(--ease-out);
	}

	.tile:hover .tile__symbol {
		color: var(--accent);
		transform: scale(1.08);
	}

	.tile__name {
		position: relative;
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--text-muted);
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: transform var(--dur-component) var(--ease-out);
	}

	/* Group label replaces the name on hover (contextual tooltip) */
	.tile__group {
		position: absolute;
		inset: auto 0 0.75rem;
		text-align: center;
		text-transform: uppercase;
		color: var(--accent);
		opacity: 0;
		transform: translateY(0.5rem);
		transition:
			opacity var(--dur-component) var(--ease-out),
			transform var(--dur-component) var(--ease-out);
	}

	@media (hover: hover) {
		.tile:hover .tile__name {
			transform: translateY(-1.1rem);
		}

		.tile:hover .tile__group {
			opacity: 1;
			transform: none;
		}
	}
</style>
