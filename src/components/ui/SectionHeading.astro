---
interface Props {
	index: number;
	label: string;
	title?: string;
	intro?: string;
	id?: string;
}

const { index, label, title, intro, id } = Astro.props;
const number = String(index).padStart(2, '0');
---

<header class="section-heading">
	<p class="section-heading__meta label" data-reveal="fade">
		<span class="section-heading__index">{number}</span>
		<span class="section-heading__rule" aria-hidden="true"></span>
		<span>{label}</span>
	</p>
	{
		title && (
			<h2 class="section-heading__title" id={id} data-reveal="mask">
				<span class="mask">{title}</span>
			</h2>
		)
	}
	{
		intro && (
			<p class="section-heading__intro" data-reveal>
				{intro}
			</p>
		)
	}
</header>

<style>
	.section-heading {
		display: grid;
		gap: 1.5rem;
		margin-bottom: clamp(3rem, 2rem + 4vw, 6rem);
	}

	.section-heading__meta {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.section-heading__index {
		color: var(--accent);
	}

	.section-heading__rule {
		width: 3rem;
		height: 1px;
		background: var(--line-strong);
	}

	.section-heading__title {
		font-size: var(--step-h1);
		max-width: 16ch;
	}

	.section-heading__intro {
		max-width: 42ch;
		font-size: var(--step-lead);
		color: var(--text-muted);
		line-height: 1.5;
	}
</style>
