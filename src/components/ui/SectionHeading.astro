---
/**
 * Two-tone headline: the title, followed by a muted continuation.
 * `Cómo trabajo. Del proceso de negocio a producción.`
 * Words rise one after another when the heading enters the viewport.
 */
interface Props {
	title: string;
	subtitle?: string;
	id?: string;
	align?: 'start' | 'center';
}

const { title, subtitle, id, align = 'start' } = Astro.props;
const titleWords = title.split(' ');
const subtitleWords = subtitle ? subtitle.split(' ') : [];
---

<h2 class:list={['heading', `heading--${align}`]} id={id} data-reveal="words">
	{
		titleWords.map((word, i) => (
			<>
				<span class="word" style={`--w: ${i}`}>
					{word}
				</span>{' '}
			</>
		))
	}
	{
		subtitleWords.length > 0 && (
			<span class="heading__subtitle">
				{subtitleWords.map((word, i) => (
					<>
						<span class="word" style={`--w: ${titleWords.length + i}`}>
							{word}
						</span>{' '}
					</>
				))}
			</span>
		)
	}
</h2>

<style>
	.heading {
		max-width: 20ch;
		margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
		font-size: var(--fs-headline);
		line-height: 1.05;
		letter-spacing: -0.028em;
	}

	.heading--center {
		margin-inline: auto;
		text-align: center;
	}

	.heading__subtitle {
		color: var(--text-secondary);
	}
</style>
