---
/**
 * Two-tone headline: the title, followed by a muted continuation.
 * `Cómo trabajo. Del proceso de negocio a producción.`
 */
interface Props {
	title: string;
	subtitle?: string;
	id?: string;
	align?: 'start' | 'center';
}

const { title, subtitle, id, align = 'start' } = Astro.props;
---

<h2 class:list={['heading', `heading--${align}`]} id={id} data-reveal>
	{title}{subtitle && ' '}
	{subtitle && <span class="heading__subtitle">{subtitle}</span>}
</h2>

<style>
	.heading {
		max-width: 20ch;
		margin-bottom: clamp(3rem, 2rem + 3vw, 5rem);
		font-size: var(--fs-headline);
		line-height: 1.05;
		letter-spacing: -0.028em;
	}

	.heading--center {
		margin-inline: auto;
		text-align: center;
	}

	.heading__subtitle {
		color: var(--text-secondary);
	}
</style>
