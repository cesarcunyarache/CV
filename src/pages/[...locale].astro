---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header/Header.astro';
import Hero from '../components/Hero/Hero.astro';
import About from '../components/About/About.astro';
import Projects from '../components/Projects/Projects.astro';
import Approach from '../components/Approach/Approach.astro';
import Experience from '../components/Experience/Experience.astro';
import Skills from '../components/Skills/Skills.astro';
import Education from '../components/Education/Education.astro';
import Contact from '../components/Contact/Contact.astro';
import Footer from '../components/Footer/Footer.astro';
import BrandSprite from '../components/ui/BrandSprite.astro';
import { getContent } from '../data';
import { defaultLocale, locales } from '../i18n/config';

/** `/` → default locale, `/en/` → English, one page per configured locale. */
export const getStaticPaths = (() =>
	locales.map((locale) => ({
		params: { locale: locale === defaultLocale ? undefined : locale },
		props: { locale },
	}))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale } = Astro.props;
const content = getContent(locale);
const { t } = content;
---

<BaseLayout locale={locale} content={content} title={t.meta.title} description={t.meta.description}>
	<BrandSprite />
	<Header locale={locale} content={content} />
	<main id="main">
		<Hero content={content} />
		<About content={content} />
		<Projects content={content} />
		<Approach content={content} />
		<Experience content={content} locale={locale} />
		<Skills content={content} />
		<Education content={content} locale={locale} />
		<Contact content={content} />
	</main>
	<Footer content={content} />
</BaseLayout>
